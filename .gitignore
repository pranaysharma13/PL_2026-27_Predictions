# Virtual environment. Never commit this: it is large, machine-specific, and
# anyone cloning the repo builds their own with the commands in the README.
.venv/
venv/
env/

# Downloaded data. Excluded for two reasons. It is regenerated by running
# fetch-xg and any command that touches results, so committing it adds tens of
# megabytes for nothing. And redistributing someone else's dataset is a
# different act from linking to it: football-data.co.uk and Understat both make
# their data freely available, but publishing a mirror of it is your decision to
# make deliberately, not something a repo should do as a side effect.
data_cache/
xg_cache/

# Generated output
projections.csv
card.csv
*.out.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db